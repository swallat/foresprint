{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Maintenance policy: docs/maintenance.md. Later package rules win over earlier ones.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1-5"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "automergeType": "pr",
  "rebaseWhen": "behind-base-branch",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "addLabels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Merge non-major updates once every check on the PR is green.",
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "Group the Go modules.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "go dependencies"
    },
    {
      "description": "Group the frontend packages.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "npm dependencies"
    },
    {
      "description": "0.x versions: a minor step may break the API, treat it like a major.",
      "matchCurrentVersion": "/^(==|~=|>=|\\^|~|v)?0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Core libraries: the tests do not catch their breakage reliably (window host, Excel files).",
      "matchPackageNames": [
        "github.com/wailsapp/wails/v2",
        "github.com/xuri/excelize/v2"
      ],
      "groupName": "core libraries",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Go and Node versions (go.mod, mise.toml, workflows): never merged on their own.",
      "matchDepNames": ["go", "golang", "node", "nodejs", "uv"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Same by datasource, in case a tool reports another name.",
      "matchDatasources": ["golang-version", "node-version"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Actions of the release chain (artifacts, signing, attestation): never merged on their own.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact",
        "actions/attest-build-provenance",
        "sigstore/cosign-installer",
        "anthropics/claude-code-action"
      ],
      "groupName": "release chain actions",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Major updates are only prepared, never merged on their own.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review", "major"]
    }
  ]
}
