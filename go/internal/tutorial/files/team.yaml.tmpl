name: Team Atlas
unit: SP
features:
  products: true
  po: {{.Full}}
  production: {{.Full}}
  tickets: {{.Tickets}}
  projects: {{.Full}}
{{- if .Full}}
product_owners:
- {id: mara, name: Mara Muster}
- {id: noel, name: Noel Muster}
{{- end}}
sprint:
  length_days: 14
  numbering: sequential
  first:
    id: '1'
    start: {{day -84}}
forecast:
  reference_capacity: 40
  window: 5
  roadmap_share: 0.8
  rounding: 1
  trend_mode: flat
  horizon: 3
capacity:
  overhead_share: 0.0
  region: NW
  rounding: 1
{{- if eq .Source "packages"}}
tracker:
  kind: packages
  package_prefix: AP
{{- else if eq .Source "tracker"}}
tracker:
  kind: jira
  base_url: https://tracker.example.org
  query: project = ATL
{{- end}}
