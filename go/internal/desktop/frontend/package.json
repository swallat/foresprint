{
  "name": "foresprint-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.mjs && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/check-i18n.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.40.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "22.18.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "27.0.1",
    "svelte": "5.57.2",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
